    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
